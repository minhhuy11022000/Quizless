# Copy this file to .env.local and fill in your Supabase project's values.
# Find both in your Supabase project's dashboard: Settings > API.
# These are safe to expose to the browser (NEXT_PUBLIC_*) — access control
# is enforced by Postgres Row Level Security, not by keeping these secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
